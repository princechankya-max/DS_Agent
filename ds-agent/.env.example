NODE_ENV=development
DEMO_MODE=true
PORT=3001
APP_URL=http://localhost:5173
JWT_SECRET=
JWT_REFRESH_SECRET=

# Demo Compose overrides SMTP with Mailpit. Replace this with a real provider for deployment.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DS Agent <no-reply@example.com>"

# Optional comma-separated browser origins. Defaults include APP_URL.
CORS_ORIGINS=

# Compose demo credentials only. Replace all credentials for any shared or deployed environment.
POSTGRES_PASSWORD=dsagent-demo-only
RUSTFS_ACCESS_KEY=dsagent-demo
RUSTFS_SECRET_KEY=dsagent-demo-only

# Compose supplies these services; a deployed environment must point to managed services.
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
REDIS_URL=
ANALYSIS_WORKER_CONCURRENCY=2
AI_ANALYST_API_KEY=
AI_ANALYST_BASE_URL=https://api.openai.com/v1
AI_ANALYST_MODEL=gpt-4o-mini
AI_ANALYST_TIMEOUT_MS=20000
AI_ANALYST_QUERY_TIMEOUT_MS=60000
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=ds-agent
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PATH_STYLE=true
OBJECT_STORAGE_SSE=

# Optional persistent data paths; Docker Compose sets these automatically.
DB_PATH=
UPLOADS_DIR=
OUTPUTS_DIR=
TEMP_WORK_DIR=
MIGRATION_SQLITE_PATH=
MIGRATION_UPLOADS_DIR=
MIGRATION_OUTPUTS_DIR=

# Razorpay test/live credentials and monthly plan IDs.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO_MONTHLY_ID=
RAZORPAY_PLAN_BUSINESS_MONTHLY_ID=
